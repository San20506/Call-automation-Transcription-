# Environment Variables Template
# Copy this to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# ============================================================================
# API Keys (REQUIRED)
# ============================================================================

# Sarvam AI - For Hindi transcription
# Get from: https://sarvam.ai/pricing
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Gemini - For translation and analysis
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace - For speaker diarization models
# Get from: https://huggingface.co/settings/tokens
# Make sure to accept model licenses (see README)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ============================================================================
# Optional Configuration Overrides
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Maximum file size in MB
# MAX_FILE_SIZE_MB=500

# Maximum audio duration in seconds
# MAX_DURATION_SECONDS=3600

# Number of speakers to detect (auto-detect if not set)
# NUM_SPEAKERS=2

# Use GPU if available (true/false)
# USE_GPU=true

# ============================================================================
# Advanced Settings (Usually don't need to change)
# ============================================================================

# Gemini model to use
# GEMINI_MODEL=gemini-1.5-flash

# Translation temperature (0.0 = deterministic, 2.0 = creative)
# TRANSLATION_TEMPERATURE=0.3

# Enable translation caching
# ENABLE_CACHING=true

# Maximum retry attempts for API calls
# MAX_RETRY_ATTEMPTS=3

# ============================================================================
# Production Deployment (Optional)
# ============================================================================

# Database connection (for job tracking)
# DATABASE_URL=postgresql://user:pass@localhost/callanalysis

# Redis connection (for caching/queue)
# REDIS_URL=redis://localhost:6379/0

# Monitoring/Observability
# PROMETHEUS_PORT=9090
# SENTRY_DSN=your_sentry_dsn_here
