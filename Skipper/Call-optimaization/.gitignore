# ============================================================================
# KEEP THESE (Documentation)
# ============================================================================

# Keep template files
!.env.template
!config.template.py

# Keep example files
!examples/*.py

# Keep test fixtures
!tests/fixtures/*.wav
!tests/fixtures/*.mp3
